PG_DSN=postgresql://postgres:postgres@localhost:5432/oraculo

# Telegram routing (optional)
TELEGRAM_BOT_EVENTS_TOKEN=
TELEGRAM_CHAT_EVENTS=
TELEGRAM_BOT_RULES_TOKEN=
TELEGRAM_CHAT_RULES=
TELEGRAM_BOT_ERRORS_TOKEN=
TELEGRAM_CHAT_ERRORS=

# Deribit (optional; required for raw trades)
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# Runtime knobs
ENV=dev
ORACULO_METRICS_PORT=9001
ORACULO_WATCHDOG_LAG_THRESHOLD=2.0
ORACULO_WATCHDOG_LAG_IMMEDIATE_THRESHOLD=10.0
ORACULO_WATCHDOG_CONSECUTIVE=3
ORACULO_WATCHDOG_QUEUE_THRESHOLD=50
ORACULO_WATCHDOG_COOLDOWN_S=30.0
